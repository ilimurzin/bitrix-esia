{
    "name": "ilimurzin/bitrix-esia",
    "description": "Модуль для Битрикса. Добавляет «Госуслуги» в «социальные сервисы».",
    "type": "bitrix-d7-module",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "^2.0",
        "psr/log": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "rector/rector": "^2.0.11",
        "friendsofphp/php-cs-fixer": "^3.63",
        "phpstan/phpstan": "^2.1",
        "webmasterskaya/crypto-pro-php-stubs": "dev-for-ilimurzin-esia"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/ilimurzin/crypto-pro-php-stubs.git"
        }
    ],
    "scripts": {
        "cs:check": "php-cs-fixer check",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan --memory-limit=256M",
        "rector:check": "rector --dry-run",
        "rector:fix": "rector"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-name": "esia"
    }
}
